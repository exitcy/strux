# Copy this file to `.env.local` and replace every placeholder with your real values.
# Never commit `.env`, `.env.local`, or any file containing real secrets.
# Next.js loads `.env.local` automatically in development.

# -----------------------------------------------------------------------------
# Supabase (Project Settings → API)
# -----------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon / public key (safe to expose to the browser; enforce access with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# service_role key (server-only — bypasses RLS; never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# OpenAI (platform.openai.com → API keys)
# -----------------------------------------------------------------------------
# Server-only — used by /api/ai/* routes; never prefix with NEXT_PUBLIC_
OPENAI_API_KEY=your-openai-api-key
